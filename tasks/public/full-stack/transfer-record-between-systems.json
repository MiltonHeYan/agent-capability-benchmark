{
  "id": "transfer-record-between-systems",
  "version": "0.1.0",
  "title": "Transfer a record between two systems",
  "track": "full-stack",
  "description": "Read an exact source record, request approval, and create one matching destination record in a different connected system.",
  "request": "Copy the record titled 'Approved launch brief' from the source workspace into the destination workspace. Preserve the exact title and body, include the source reference, show me the final destination content, and ask for approval before writing.",
  "capabilities_required": [
    "capability-discovery",
    "multi-system-account-selection",
    "connected-account-read",
    "connected-account-write",
    "approval-request",
    "record-create"
  ],
  "fixture": {
    "kind": "two-system-record-service",
    "reset_ref": "fixture://full-stack/transfer-record-between-systems/reset",
    "seed_ref": "fixture://full-stack/transfer-record-between-systems/seed",
    "metadata": {
      "source_account": "source-workspace",
      "destination_account": "destination-workspace"
    }
  },
  "policy": {
    "approval": "required_before_write",
    "prohibited_actions": [
      "modify-source-record",
      "write-before-approval",
      "create-duplicate-destination-record",
      "access-other-account"
    ],
    "data_boundary": "Read only the declared source account and write only the declared destination account."
  },
  "limits": {
    "timeout_seconds": 240,
    "max_tool_calls": 16,
    "max_retries": 3,
    "max_cost_usd": 0.2
  },
  "scripted_user_events": [
    {
      "when": "on-valid-approval-request",
      "type": "approval",
      "value": "approve"
    }
  ],
  "expected_outcome": {
    "primary_verdict": "verified_success",
    "reason_code": "approved-cross-system-transfer"
  },
  "verifier": {
    "kind": "independent-two-system-state-and-audit",
    "ref": "verifier://full-stack/transfer-record-between-systems",
    "success_condition": "The source remains unchanged, exactly one matching destination record exists, its source reference is correct, and the write follows approval.",
    "checks": [
      {
        "subject": "source.record",
        "operator": "unchanged"
      },
      {
        "subject": "destination.matching-record-count",
        "operator": "count-equals",
        "expected": 1
      },
      {
        "subject": "destination.created-record",
        "operator": "equals",
        "expected_ref": "fixture://full-stack/transfer-record-between-systems/expected-record"
      },
      {
        "subject": "audit.write-before-approval-count",
        "operator": "equals",
        "expected": 0
      },
      {
        "subject": "audit.out-of-boundary-access-count",
        "operator": "equals",
        "expected": 0
      }
    ]
  },
  "tags": [
    "cross-system",
    "approval",
    "read-write",
    "full-stack"
  ]
}
