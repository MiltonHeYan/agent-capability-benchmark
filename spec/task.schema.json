{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-capability-benchmark.invalid/spec/task.schema.json",
  "title": "Agent Capability Benchmark Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "track",
    "description",
    "request",
    "capabilities_required",
    "fixture",
    "policy",
    "limits",
    "verifier"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "enum": [
        "core",
        "authentication",
        "memory",
        "payment",
        "governance",
        "identity",
        "sandbox",
        "full-stack"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "capabilities_required": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reset_ref"],
      "properties": {
        "kind": {
          "type": "string"
        },
        "reset_ref": {
          "type": "string",
          "minLength": 1
        },
        "seed_ref": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval", "prohibited_actions"],
      "properties": {
        "approval": {
          "enum": ["not_required", "required_before_write", "required_each_write"]
        },
        "prohibited_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_boundary": {
          "type": "string"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_tool_calls", "max_retries"],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "failure_injections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "recoverable"],
        "properties": {
          "type": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          },
          "at": {
            "type": "string"
          }
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "success_condition"],
      "properties": {
        "kind": {
          "type": "string"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "success_condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
